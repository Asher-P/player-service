{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Orleans": "Warning"
      }
    }
  },
  "AlertLog": {
    "Enabled": true,
    "Directory": "Alert-Logs",
    "MinimumLevel": "Warning",
    "RetainedFileCountLimit": 30
  },
  "AllowedHosts": "*",
  "Sessions": {
    "Ttl": "00:03:00"
  },
  "Idempotency": {
    "MaxEntriesPerPlayer": 256,
    "Ttl": "00:10:00"
  },
  "Gifting": {
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:00.100"
  },
  "Leaderboard": {
    "TopN": 100,
    "BroadcastInterval": "00:00:01.000"
  },
  "Observability": {
    "Enabled": true,
    "TracesOtlpEndpoint": "",
    "MetricsOtlpEndpoint": "",
    "UseHttpProtobuf": false,
    "MetricExportIntervalSeconds": 15,
    "DashboardEnabled": true,
    "DashboardPath": "/dashboard"
  }
}