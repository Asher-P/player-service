{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Sessions": {
    "Ttl": "00:02:00"
  },

  "Idempotency": {
    "MaxEntriesPerPlayer": 256,
    "Ttl": "00:10:00"
  },

  "Gifting": {
    "MaxAttempts": 8,
    "RetryBaseDelay": "00:00:00.100"
  },

  "Leaderboard": {
    "TopN": 100,
    "BroadcastInterval": "00:00:01.000"
  },

  "Observability": {
    "Enabled": true,
    "TracesOtlpEndpoint": "http://localhost:4317",
    "MetricsOtlpEndpoint": "",
    "UseHttpProtobuf": false,
    "DashboardEnabled": true,
    "DashboardPath": "/dashboard"
  }
}
