# Host-side ports only. Container-internal ports are always the standard ones.
#
# These defaults deliberately avoid the well-known ports (16686, 4317/4318, 9090, 3000) so the stack
# comes up next to a Jaeger, Prometheus or Grafana that is already running. If those ports are free
# on your machine, the commented values are the conventional choices.

PLAYER_SERVICE_PORT=5080

JAEGER_UI_PORT=16687          # conventional: 16686
JAEGER_OTLP_GRPC_PORT=4327    # conventional: 4317
JAEGER_OTLP_HTTP_PORT=4328    # conventional: 4318

PROMETHEUS_PORT=9101          # conventional: 9090
GRAFANA_PORT=3501             # conventional: 3000
